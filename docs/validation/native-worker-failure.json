  "plan": {
    "scope": "Real native ModelRuntime and HTTP failure propagation over a deliberately malformed tiny CUDA graph catalog; no checkpoint inference.",
    "abi_version": 2,
    "cases": [
      "waiting-json",
      "waiting-sse"
    ],
    "trigger": "Initialization graph writes 1 into completion_records[:, :, 7] (reserved ABI field).",
    "path": [
      "GraphExecutor::poll/decode_records",
      "run_loop returns Err",
      "ModelRuntime marks unhealthy and fails active/pending/queued requests",
      "executor drains model/copy streams",
      "HTTP health returns 503"
    ],
    "checks": [
      "health 200 before submission",
      "one real initialization graph submitted",
      "waiting JSON returns 500 with exact fatal error",
      "waiting SSE returns 200 with one terminal error, no [DONE] or successful finish",
      "health 503 after fatal worker exit",
      "subsequent chat returns 503",
      "Server.healthy and wait are false",
      "close retains error and confirms drain",
      "owner retained until close then released",
      "CPU scheduler resources fully returned"
    ],
    "http_timeout_seconds": 30,
    "gpu_policy": "One explicitly assigned UUID; no model weights, no existing endpoint contacted.",
    "limitations": [
      "Does not force a Rust panic or a CUDA execution fault.",
      "Does not validate checkpoint outputs, multi-request error fanout, or failed CUDA drain."
    ]
  },
